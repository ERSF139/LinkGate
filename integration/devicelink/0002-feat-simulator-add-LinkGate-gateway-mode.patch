 simulator/gatewayuplink.h     |  57 +++++++++++++
 simulator/simulatorwindow.cpp |  57 ++++++++++++-
 simulator/simulatorwindow.h   |  10 +++
 5 files changed, 273 insertions(+), 2 deletions(-)
 create mode 100644 simulator/gatewayuplink.cpp
